M,CAChC,CAAC,C","file":"x","sourcesContent":["import React from 'react';\n\nconst Dashboard: React.FC = () => {\n    return (\n        <div>\n            <h1>Mental Health Dashboard</h1>\n            <p>Welcome to your mental health metrics and insights.</p>\n            {/* Additional components and metrics can be added here */}\n        </div>\n    );\n};\n\nexport default Dashboard;","import axios from 'axios';\nimport { PatientProfileData } from '../types';\n\nconst apiClient = axios.create({\n    baseURL: process.env.REACT_APP_API_URL || 'http://localhost:3000/api',\n    timeout: 10000,\n});\n\nexport const fetchPatientProfile = async (patientId: string): Promise<PatientProfileData> => {\n    try {\n        const response = await apiClient.get(`/patients/${patientId}`);\n        return response.data;\n    } catch (error) {\n        const e = error as any;\n        throw new Error('Error fetching patient profile: ' + (e.message || String(e)));\n    }\n};\n\nexport const submitMentalHealthData = async (patientId: string, data: any): Promise<any> => {\n    try {\n        const response = await apiClient.post(`/patients/${patientId}/mental-health`, data);\n        return response.data;\n    } catch (error) {\n        const e = error as any;\n        throw new Error('Error submitting mental health data: ' + (e.message || String(e)));\n    }\n};","import React from 'react';\nimport { useParams } from 'react-router-dom';\nimport { fetchPatientProfile } from '../services/api';\nimport { PatientProfileData } from '../types';\n\nconst PatientProfile: React.FC = () => {\n    const { id } = useParams<{ id: string }>();\n    const [patientData, setPatientData] = React.useState<PatientProfileData | null>(null);\n    const [loading, setLoading] = React.useState<boolean>(true);\n    const [error, setError] = React.useState<string | null>(null);\n\n    React.useEffect(() => {\n        const getPatientProfile = async () => {\n            try {\n                const data = await fetchPatientProfile(id);\n                setPatientData(data);\n            } catch (err) {\n                setError('Failed to fetch patient profile');\n            } finally {\n                setLoading(false);\n            }\n        };\n\n        getPatientProfile();\n    }, [id]);\n\n    if (loading) {\n        return <div>Loading...</div>;\n    }\n\n    if (error) {\n        return <div>{error}</div>;\n    }\n\n    if (!patientData) {\n        return <div>No patient data found.</div>;\n    }\n\n    return (\n        <div>\n            <h1>{patientData.name}'s Profile</h1>\n            <p>Age: {patientData.age}</p>\n            <h2>Mental Health Metrics</h2>\n            <ul>\n                <li>Anxiety: {patientData.mentalHealthMetrics.anxietyLevel}</li>\n                <li>Depression: {patientData.mentalHealthMetrics.depressionLevel}</li>\n                <li>Stress: {patientData.mentalHealthMetrics.stressLevel}</li>\n            </ul>\n        </div>\n    );\n};\n\nexport default PatientProfile;","import React from 'react';\nimport { BrowserRouter as Router, Route, Switch } from 'react-router-dom';\nimport Dashboard from './components/Dashboard';\nimport PatientProfile from './pages/PatientProfile';\n\nconst App: React.FC = () => {\n  return (\n    <Router>\n      <Switch>\n        <Route path=\"/\" exact component={Dashboard} />\n        <Route path=\"/patient/:id\" component={PatientProfile} />\n      </Switch>\n    </Router>\n  );\n};\n\nexport default App;","import React from 'react';\nimport ReactDOM from 'react-dom';\nimport App from './App';\n\nReactDOM.render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>,\n  document.getElementById('root')\n);"]}}